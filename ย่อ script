	ToggleKey = Enum.KeyCode.RightShift,
}

local origLighting = {
	GlobalShadows = Lighting.GlobalShadows,
	FogEnd = Lighting.FogEnd,
	FogStart = Lighting.FogStart,
	Brightness = Lighting.Brightness,
	EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
	EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
}

local state = {
	LongSight = true,
	BoostFPS = true,
	UiVisible = true,
}

local function applyLongSight(enabled)
	state.LongSight = enabled
	if enabled then
		Lighting.FogStart = CONFIG.MaxSightDistance * 0.75
		Lighting.FogEnd = CONFIG.MaxSightDistance

		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("Atmosphere") then
				if child:GetAttribute("SavedDensity") == nil then
					child:SetAttribute("SavedDensity", child.Density)
					child:SetAttribute("SavedHaze", child.Haze)
				end
				child.Density = 0.05
				child.Haze = 0.1
			end
		end

		pcall(function()
			workspace.StreamingMinRadius = math.max(workspace.StreamingMinRadius, 512)
			workspace.StreamingTargetRadius = math.max(workspace.StreamingTargetRadius, 2048)
		end)
	else
		Lighting.FogStart = origLighting.FogStart
		Lighting.FogEnd = origLighting.FogEnd

		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("Atmosphere") then
				local d = child:GetAttribute("SavedDensity")
				local h = child:GetAttribute("SavedHaze")
				if d ~= nil then child.Density = d end
				if h ~= nil then child.Haze = h end
			end
		end
	end
end

local function optimizePart(obj)
	if not state.BoostFPS then return end
	if obj:IsA("BasePart") then
		obj.CastShadow = false
	elseif obj:IsA("ParticleEmitter") then
		if obj:GetAttribute("OrigRate") == nil then
			obj:SetAttribute("OrigRate", obj.Rate)
		end
		obj.Rate = math.clamp(obj.Rate * 0.35, 1, 25)
	end
end

local function applyBoostFPS(enabled)
	state.BoostFPS = enabled
	if enabled then
		Lighting.GlobalShadows = false
		Lighting.Brightness = 2.5
		Lighting.EnvironmentSpecularScale = 0
		Lighting.EnvironmentDiffuseScale = 0.5

		for _, effect in ipairs(Lighting:GetChildren()) do
			if effect:IsA("PostEffect") then
				if effect:GetAttribute("OrigEnabled") == nil then
					effect:SetAttribute("OrigEnabled", effect.Enabled)
				end
				effect.Enabled = false
			end
		end

		for _, desc in ipairs(workspace:GetDescendants()) do
			optimizePart(desc)
		end
	else
		Lighting.GlobalShadows = origLighting.GlobalShadows
		Lighting.Brightness = origLighting.Brightness
		Lighting.EnvironmentSpecularScale = origLighting.EnvironmentSpecularScale
		Lighting.EnvironmentDiffuseScale = origLighting.EnvironmentDiffuseScale

		for _, effect in ipairs(Lighting:GetChildren()) do
			if effect:IsA("PostEffect") then
				local orig = effect:GetAttribute("OrigEnabled")
				if orig ~= nil then effect.Enabled = orig end
			end
		end

		for _, desc in ipairs(workspace:GetDescendants()) do
			if desc:IsA("BasePart") then
				desc.CastShadow = true
			elseif desc:IsA("ParticleEmitter") then
				local r = desc:GetAttribute("OrigRate")
				if r ~= nil then desc.Rate = r end
			end
		end
	end
end

workspace.DescendantAdded:Connect(function(desc)
	if state.BoostFPS then
		optimizePart(desc)
	end
end)

local function makeDraggable(frame)
	local dragging, dragInput, dragStart, startPos
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

